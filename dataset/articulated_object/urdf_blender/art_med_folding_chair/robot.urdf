<?xml version="1.0"?>
<robot name="folding_chair">
  <!-- link frames: root at the world origin; every other link frame sits at its joint pivot (world, rest pose). -->
  <!-- visual/collision origin = -(link frame world) because meshes/<link>.glb hold WORLD coordinates at rest. -->
  <!-- q=0 is the authored pose (the plan's rest pose); limits are the plan's lower-rest .. upper-rest. -->
  <link name="main_frame">  <!-- frame at world 0 0 0 -->
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/main_frame.glb"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/main_frame.glb"/></geometry></collision>
  </link>
  <link name="seat">  <!-- frame at world 0 0.09 0.44 -->
    <visual><origin xyz="0 -0.09 -0.44" rpy="0 0 0"/><geometry><mesh filename="meshes/seat.glb"/></geometry></visual>
    <collision><origin xyz="0 -0.09 -0.44" rpy="0 0 0"/><geometry><mesh filename="meshes/seat.glb"/></geometry></collision>
  </link>
  <link name="front_leg_frame">  <!-- frame at world 0 -0.04 0.42 -->
    <visual><origin xyz="0 0.04 -0.42" rpy="0 0 0"/><geometry><mesh filename="meshes/front_leg_frame.glb"/></geometry></visual>
    <collision><origin xyz="0 0.04 -0.42" rpy="0 0 0"/><geometry><mesh filename="meshes/front_leg_frame.glb"/></geometry></collision>
  </link>
  <joint name="seat_hinge" type="revolute">
    <parent link="main_frame"/>
    <child link="seat"/>
    <origin xyz="0 0.09 0.44" rpy="0 0 0"/>  <!-- pivot_world(child) - frame_world(parent) -->
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="1.43" effort="10" velocity="1"/>
  </joint>
  <joint name="front_leg_pivot" type="revolute">
    <parent link="main_frame"/>
    <child link="front_leg_frame"/>
    <origin xyz="0 -0.04 0.42" rpy="0 0 0"/>  <!-- pivot_world(child) - frame_world(parent) -->
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.45" effort="10" velocity="1"/>
  </joint>
</robot>
