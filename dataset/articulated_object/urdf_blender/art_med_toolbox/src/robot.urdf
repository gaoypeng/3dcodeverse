<?xml version="1.0"?>
<robot name="metal_toolbox">
  <!-- link frames: root at the world origin; every other link frame sits at its joint pivot (world, rest pose). -->
  <!-- visual/collision origin = -(link frame world) because meshes/<link>.glb hold WORLD coordinates at rest. -->
  <!-- q=0 is the authored pose (the plan's rest pose); limits are the plan's lower-rest .. upper-rest. -->
  <link name="body">  <!-- frame at world 0 0 0 -->
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/body.glb"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/body.glb"/></geometry></collision>
  </link>
  <link name="lid">  <!-- frame at world 0 0.104 0.16 -->
    <visual><origin xyz="0 -0.104 -0.16" rpy="0 0 0"/><geometry><mesh filename="meshes/lid.glb"/></geometry></visual>
    <collision><origin xyz="0 -0.104 -0.16" rpy="0 0 0"/><geometry><mesh filename="meshes/lid.glb"/></geometry></collision>
  </link>
  <link name="handle">  <!-- frame at world 0 0 0.222 -->
    <visual><origin xyz="0 0 -0.222" rpy="0 0 0"/><geometry><mesh filename="meshes/handle.glb"/></geometry></visual>
    <collision><origin xyz="0 0 -0.222" rpy="0 0 0"/><geometry><mesh filename="meshes/handle.glb"/></geometry></collision>
  </link>
  <link name="latch">  <!-- frame at world 0 -0.105 0.17 -->
    <visual><origin xyz="0 0.105 -0.17" rpy="0 0 0"/><geometry><mesh filename="meshes/latch.glb"/></geometry></visual>
    <collision><origin xyz="0 0.105 -0.17" rpy="0 0 0"/><geometry><mesh filename="meshes/latch.glb"/></geometry></collision>
  </link>
  <joint name="lid_hinge" type="revolute">
    <parent link="body"/>
    <child link="lid"/>
    <origin xyz="0 0.104 0.16" rpy="0 0 0"/>  <!-- pivot_world(child) - frame_world(parent) -->
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="1.745" effort="10" velocity="1"/>
  </joint>
  <joint name="handle_hinge" type="revolute">
    <parent link="lid"/>
    <child link="handle"/>
    <origin xyz="0 -0.104 0.062" rpy="0 0 0"/>  <!-- pivot_world(child) - frame_world(parent) -->
    <axis xyz="1 0 0"/>
    <limit lower="-1.48" upper="1.48" effort="10" velocity="1"/>
  </joint>
  <joint name="latch_hinge" type="revolute">
    <parent link="lid"/>
    <child link="latch"/>
    <origin xyz="0 -0.209 0.01" rpy="0 0 0"/>  <!-- pivot_world(child) - frame_world(parent) -->
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="1.8" effort="10" velocity="1"/>
  </joint>
</robot>
