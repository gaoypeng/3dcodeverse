<?xml version="1.0"?>
<robot name="BedsideCabinet">
  <link name="Carcass">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/Carcass.glb"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/Carcass.glb"/></geometry>
    </collision>
  </link>

  <link name="Drawer">
    <visual>
      <origin xyz="0 0.181 -0.505" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/Drawer.glb"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0.181 -0.505" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/Drawer.glb"/></geometry>
    </collision>
  </link>

  <link name="DrawerKnob">
    <visual>
      <origin xyz="0 0.199 -0.505" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/DrawerKnob.glb"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0.199 -0.505" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/DrawerKnob.glb"/></geometry>
    </collision>
  </link>

  <link name="Door">
    <visual>
      <origin xyz="0.198 0.190 -0.260" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/Door.glb"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.198 0.190 -0.260" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/Door.glb"/></geometry>
    </collision>
  </link>

  <link name="DoorKnob">
    <visual>
      <origin xyz="-0.160 0.199 -0.260" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/DoorKnob.glb"/></geometry>
    </visual>
    <collision>
      <origin xyz="-0.160 0.199 -0.260" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/DoorKnob.glb"/></geometry>
    </collision>
  </link>

  <!-- Joint: Carcass -> Drawer (prismatic along -Y) -->
  <joint name="CarcassToDrawer" type="prismatic">
    <parent link="Carcass"/>
    <child link="Drawer"/>
    <origin xyz="0.000 -0.181 0.505" rpy="0 0 0"/>
    <axis xyz="0.000 -1.000 0.000"/>
    <limit lower="0.000" upper="0.240" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Joint: Drawer -> DrawerKnob (fixed) -->
  <joint name="DrawerToDrawerKnob" type="fixed">
    <parent link="Drawer"/>
    <child link="DrawerKnob"/>
    <origin xyz="0.000 -0.018 0.000" rpy="0 0 0"/>
  </joint>

  <!-- Joint: Carcass -> Door (revolute about vertical axis along -Z / right-hand rule) -->
  <joint name="CarcassToDoor" type="revolute">
    <parent link="Carcass"/>
    <child link="Door"/>
    <origin xyz="-0.198 -0.190 0.260" rpy="0 0 0"/>
    <axis xyz="0.000 0.000 -1.000"/>
    <limit lower="0.000" upper="1.600" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Joint: Door -> DoorKnob (fixed) -->
  <joint name="DoorToDoorKnob" type="fixed">
    <parent link="Door"/>
    <child link="DoorKnob"/>
    <origin xyz="0.358 -0.009 0.000" rpy="0 0 0"/>
  </joint>

</robot>
