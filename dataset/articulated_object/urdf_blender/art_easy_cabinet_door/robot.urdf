<?xml version="1.0"?>
<robot name="kitchen_wall_cabinet">
  <!-- link frames: root at the world origin; every other link frame sits at its joint pivot (world, rest pose). -->
  <!-- visual/collision origin = -(link frame world) because meshes/<link>.glb hold WORLD coordinates at rest. -->
  <!-- q=0 is the authored pose (the plan's rest pose); limits are the plan's lower-rest .. upper-rest. -->
  <link name="carcass">  <!-- frame at world 0 0 0 -->
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/carcass.glb"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/carcass.glb"/></geometry></collision>
  </link>
  <link name="door">  <!-- frame at world -0.245 -0.16 0.35 -->
    <visual><origin xyz="0.245 0.16 -0.35" rpy="0 0 0"/><geometry><mesh filename="meshes/door.glb"/></geometry></visual>
    <collision><origin xyz="0.245 0.16 -0.35" rpy="0 0 0"/><geometry><mesh filename="meshes/door.glb"/></geometry></collision>
  </link>
  <link name="handle">  <!-- frame at world 0.2 -0.178 0.35 -->
    <visual><origin xyz="-0.2 0.178 -0.35" rpy="0 0 0"/><geometry><mesh filename="meshes/handle.glb"/></geometry></visual>
    <collision><origin xyz="-0.2 0.178 -0.35" rpy="0 0 0"/><geometry><mesh filename="meshes/handle.glb"/></geometry></collision>
  </link>
  <joint name="door_hinge" type="revolute">
    <parent link="carcass"/>
    <child link="door"/>
    <origin xyz="-0.245 -0.16 0.35" rpy="0 0 0"/>  <!-- pivot_world(child) - frame_world(parent) -->
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.92" effort="10" velocity="1"/>
  </joint>
  <joint name="handle_mount" type="fixed">
    <parent link="door"/>
    <child link="handle"/>
    <origin xyz="0.445 -0.018 0" rpy="0 0 0"/>  <!-- pivot_world(child) - frame_world(parent) -->
  </joint>
</robot>
