<?xml version="1.0"?>
<robot name="bedside_drawer_unit">
  <!-- link frames: root at the world origin; every other link frame sits at its joint pivot (world, rest pose). -->
  <!-- visual/collision origin = -(link frame world) because meshes/<link>.glb hold WORLD coordinates at rest. -->
  <!-- q=0 is the authored pose (the plan's rest pose); limits are the plan's lower-rest .. upper-rest. -->
  <link name="carcass">  <!-- frame at world 0 0 0 -->
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/carcass.glb"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/carcass.glb"/></geometry></collision>
  </link>
  <link name="top_drawer">  <!-- frame at world 0 -0.015 0.425 -->
    <visual><origin xyz="0 0.015 -0.425" rpy="0 0 0"/><geometry><mesh filename="meshes/top_drawer.glb"/></geometry></visual>
    <collision><origin xyz="0 0.015 -0.425" rpy="0 0 0"/><geometry><mesh filename="meshes/top_drawer.glb"/></geometry></collision>
  </link>
  <link name="bottom_drawer">  <!-- frame at world 0 -0.015 0.215 -->
    <visual><origin xyz="0 0.015 -0.215" rpy="0 0 0"/><geometry><mesh filename="meshes/bottom_drawer.glb"/></geometry></visual>
    <collision><origin xyz="0 0.015 -0.215" rpy="0 0 0"/><geometry><mesh filename="meshes/bottom_drawer.glb"/></geometry></collision>
  </link>
  <joint name="top_drawer_slide" type="prismatic">
    <parent link="carcass"/>
    <child link="top_drawer"/>
    <origin xyz="0 -0.015 0.425" rpy="0 0 0"/>  <!-- pivot_world(child) - frame_world(parent) -->
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.32" effort="10" velocity="1"/>
  </joint>
  <joint name="bottom_drawer_slide" type="prismatic">
    <parent link="carcass"/>
    <child link="bottom_drawer"/>
    <origin xyz="0 -0.015 0.215" rpy="0 0 0"/>  <!-- pivot_world(child) - frame_world(parent) -->
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.32" effort="10" velocity="1"/>
  </joint>
</robot>
