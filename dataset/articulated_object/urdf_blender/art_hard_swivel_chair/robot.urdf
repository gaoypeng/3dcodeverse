<?xml version="1.0"?>
<robot name="office_swivel_chair">
  <!-- link frames: root at the world origin; every other link frame sits at its joint pivot (world, rest pose). -->
  <!-- visual/collision origin = -(link frame world) because meshes/<link>.glb hold WORLD coordinates at rest. -->
  <!-- q=0 is the authored pose (the plan's rest pose); limits are the plan's lower-rest .. upper-rest. -->
  <link name="base">  <!-- frame at world 0 0 0 -->
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/base.glb"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/base.glb"/></geometry></collision>
  </link>
  <link name="piston">  <!-- frame at world 0 0 0.2 -->
    <visual><origin xyz="0 0 -0.2" rpy="0 0 0"/><geometry><mesh filename="meshes/piston.glb"/></geometry></visual>
    <collision><origin xyz="0 0 -0.2" rpy="0 0 0"/><geometry><mesh filename="meshes/piston.glb"/></geometry></collision>
  </link>
  <link name="seat">  <!-- frame at world 0 0 0.41 -->
    <visual><origin xyz="0 0 -0.41" rpy="0 0 0"/><geometry><mesh filename="meshes/seat.glb"/></geometry></visual>
    <collision><origin xyz="0 0 -0.41" rpy="0 0 0"/><geometry><mesh filename="meshes/seat.glb"/></geometry></collision>
  </link>
  <link name="backrest">  <!-- frame at world 0 0.16 0.48 -->
    <visual><origin xyz="0 -0.16 -0.48" rpy="0 0 0"/><geometry><mesh filename="meshes/backrest.glb"/></geometry></visual>
    <collision><origin xyz="0 -0.16 -0.48" rpy="0 0 0"/><geometry><mesh filename="meshes/backrest.glb"/></geometry></collision>
  </link>
  <joint name="gas_lift_joint" type="prismatic">
    <parent link="base"/>
    <child link="piston"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>  <!-- pivot_world(child) - frame_world(parent) -->
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.08" effort="10" velocity="1"/>
  </joint>
  <joint name="swivel_joint" type="continuous">
    <parent link="piston"/>
    <child link="seat"/>
    <origin xyz="0 0 0.21" rpy="0 0 0"/>  <!-- pivot_world(child) - frame_world(parent) -->
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="1"/>
  </joint>
  <joint name="back_tilt_joint" type="revolute">
    <parent link="seat"/>
    <child link="backrest"/>
    <origin xyz="0 0.16 0.07" rpy="0 0 0"/>  <!-- pivot_world(child) - frame_world(parent) -->
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.35" effort="10" velocity="1"/>
  </joint>
</robot>
