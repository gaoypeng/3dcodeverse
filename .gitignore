*.egg-info/
.pytest_cache/
.ruff_cache/
node_modules/
# also the bare name: the documented worktree workflow symlinks
# harness/runtime_js/node_modules, and a symlink is a FILE to git — the
# trailing-slash pattern above does not match it, so `git add -A` committed it.
node_modules
runs/
harness/runs/
bench/out/
eval/bench/out/
# node drivers run with cwd=harness/runtime_js/, so a relative --out drops files here
harness/runtime_js/artifacts/
harness/logs/
*.pyc
harness/logs/
*.log
build/
dist/
# in-tree virtualenv (docs/INSTALL.md tells users to create one)
.venv/
.venv*/

# Local experiment history; retained on the maintainer machine, not distributed.
/harness/docs/COST.md
/harness/docs/DECISIONS.md
/harness/docs/SKILLS_LEDGER.md

# Developer-only visual studies; agents use the production starter library.
/harness/examples/graphics_lab/

# Retired tools retained locally for reference.
/.local-archive/
